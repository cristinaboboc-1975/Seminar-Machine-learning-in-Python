    "    'Proiect': [9.5, 7.0, 9.5, 8.0, 5.0, 9.5, 7.5, 9.0],\n",
    "    'Ore_Studiu': [12, 5, 18, 8, 15, 3, 22, 10]\n",
    "}\n",
    "\n",
    "df_studenti = pd.DataFrame(date_studenti)\n",
